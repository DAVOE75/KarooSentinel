<?xml version="1.0" encoding="utf-8"?>
<Extension
    id="karoo_sentinel"
    displayName="Karoo Sentinel"
    icon="@drawable/ic_launcher"
    scansDevices="false"
    mapLayer="false"
    fitFile="false">

    <BonusAction
        actionId="arm_sentinel"
        displayName="@string/bonus_action_name" />

